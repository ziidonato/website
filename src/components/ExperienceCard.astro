---
import type { CollectionEntry } from "astro:content"
import EntryCard from "@/components/EntryCard.astro"

interface Props {
  entry: CollectionEntry<"experience">
  /** This record's hue, from the section's walk of the palette. */
  accent: string
}

const { entry, accent } = Astro.props
const { company, title, location, start, end, bullets, tech, link } = entry.data
const { Content } = await entry.render()
const hasBody = (entry.body ?? "").trim().length > 0

const fmt = (ym: string) => {
  if (ym === "present") return "Present"
  const [y, m] = ym.split("-").map(Number)
  return new Date(y, m - 1, 1).toLocaleString("en-US", {
    month: "short",
    year: "numeric",
  })
}
---

<EntryCard
  anchorId={`role-${entry.id.replace(/\.mdx?$/, "")}`}
  title={title}
  entity={{ name: company, href: link }}
  subtitle={location}
  meta={`${fmt(start)} – ${fmt(end)}`}
  bullets={bullets}
  tech={tech}
  accent={accent}
>
  {
    hasBody && (
      <div class="prose prose-sm max-w-none text-foreground prose-neutral dark:prose-invert">
        <Content />
      </div>
    )
  }
</EntryCard>
