---
import { ArrowUpRight } from "@phosphor-icons/react"
import type { CollectionEntry } from "astro:content"
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"

interface Props {
  entry: CollectionEntry<"experience">
  index?: number
}

const { entry, index = 0 } = Astro.props
const { company, title, location, start, end, bullets, tech, link } = entry.data
const { Content } = await entry.render()
const hasBody = (entry.body ?? "").trim().length > 0

const ACCENTS = [
  "#ffadad",
  "#ffd6a5",
  "#fdffb6",
  "#caffbf",
  "#9bf6ff",
  "#a0c4ff",
  "#bdb2ff",
]
const accent = ACCENTS[index % ACCENTS.length]

const fmt = (ym: string) => {
  if (ym === "present") return "Present"
  const [y, m] = ym.split("-").map(Number)
  return new Date(y, m - 1, 1).toLocaleString("en-US", {
    month: "short",
    year: "numeric",
  })
}
const dateLabel = `${fmt(start)} – ${fmt(end)}`
---

<Card
  className="relative overflow-hidden transition-shadow hover:shadow-md"
  style={{ "--accent": accent }}
>
  <span
    aria-hidden="true"
    class="absolute inset-y-0 left-0 w-1 bg-[var(--accent)]"></span>

  <CardHeader>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <div class="flex flex-wrap items-baseline gap-x-2">
        <CardTitle class="font-heading text-lg leading-tight font-semibold">
          {title}
        </CardTitle>
        <span class="text-muted-foreground" aria-hidden="true">·</span>
        {
          link ? (
            <a
              href={link}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1 text-base font-medium text-foreground underline-offset-4 hover:underline focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
            >
              {company}
              <ArrowUpRight size={12} weight="bold" aria-hidden="true" />
            </a>
          ) : (
            <span class="text-base font-medium">{company}</span>
          )
        }
      </div>
      <span
        class="shrink-0 font-mono text-xs tracking-wide uppercase tabular-nums"
        style={{
          color: `color-mix(in oklab, ${accent} 60%, var(--muted-foreground))`,
        }}
      >
        {dateLabel}
      </span>
    </div>

    {location && <CardDescription class="text-sm">{location}</CardDescription>}
  </CardHeader>

  {
    (bullets.length > 0 || hasBody) && (
      <CardContent class="space-y-3 text-sm leading-relaxed text-foreground/90">
        {bullets.length > 0 && (
          <ul class="space-y-1.5">
            {bullets.map((b) => (
              <li class="flex gap-2">
                <span
                  aria-hidden="true"
                  class="mt-2 inline-block h-1 w-1 shrink-0 rounded-full"
                  style={{ backgroundColor: accent }}
                />
                <span class="text-pretty">{b}</span>
              </li>
            ))}
          </ul>
        )}
        {hasBody && (
          <div class="prose-project text-sm">
            <Content />
          </div>
        )}
      </CardContent>
    )
  }

  {
    tech.length > 0 && (
      <CardContent>
        <ul class="flex flex-wrap gap-1.5">
          {tech.map((t) => (
            <li>
              <Badge
                variant="outline"
                className="font-normal"
                style={{
                  backgroundColor: `color-mix(in oklab, ${accent} 18%, transparent)`,
                  borderColor: `color-mix(in oklab, ${accent} 50%, transparent)`,
                }}
              >
                {t}
              </Badge>
            </li>
          ))}
        </ul>
      </CardContent>
    )
  }
</Card>
