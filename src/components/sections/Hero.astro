---
import { ArrowDownIcon, EnvelopeSimpleIcon } from "@phosphor-icons/react"
import { buttonVariants } from "@/components/ui/button"
---

<section id="top" class="mx-auto max-w-4xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
  {
    /* Availability set as a plain line under the headline, not a pill above it:
      a badge floating over a headline is the standard generated-hero ornament. */
  }
  <h1
    class="max-w-3xl font-heading text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl"
  >
    Software engineer by education, builder at heart.
  </h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-foreground">
    Mostly that means taking the rigor and processes from other engineering
    fields and applying them to software.
  </p>
  <p class="mt-4 font-mono text-xs text-muted-foreground">
    Software engineer · New York · open to work
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a href="#projects" class={buttonVariants({ size: "lg" }) + " gap-2"}>
      See my work
      <ArrowDownIcon size={16} weight="bold" aria-hidden="true" />
    </a>
    <a
      href="#contact"
      class={buttonVariants({ size: "lg", variant: "outline" }) + " gap-2"}
    >
      <EnvelopeSimpleIcon size={16} weight="regular" aria-hidden="true" />
      Get in touch
    </a>
  </div>
</section>
