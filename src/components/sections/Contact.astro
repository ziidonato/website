---
import { ArrowUpRight } from "@phosphor-icons/react"
import SectionHeading from "@/components/SectionHeading.astro"

const channels = [
  {
    label: "Email",
    value: "zii.donato@outlook.com",
    href: "mailto:zii.donato@outlook.com",
  },
  {
    label: "GitHub",
    value: "@ziidonato",
    href: "https://github.com/ziidonato",
  },
]
---

<section id="contact" class="mx-auto max-w-4xl scroll-mt-20 px-6 py-16">
  <SectionHeading eyebrow="05 / Contact" accent="#bdb2ff">
    Get in touch
  </SectionHeading>
  <p class="mb-8 max-w-xl text-pretty text-muted-foreground">
    The fastest way to reach me is email. I'm happy to chat about interesting
    work, collaborations, or anything you're building.
  </p>
  <ul class="divide-y divide-border border-y border-border">
    {
      channels.map(({ label, value, href }) => (
        <li>
          <a
            href={href}
            class="flex items-center justify-between gap-4 py-4 transition-colors hover:bg-muted/40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
            rel={href.startsWith("http") ? "noopener" : undefined}
            target={href.startsWith("http") ? "_blank" : undefined}
          >
            <span class="text-sm font-medium text-muted-foreground">
              {label}
            </span>
            <span class="inline-flex items-center gap-2 font-mono text-sm">
              {value}
              <ArrowUpRight
                size={14}
                weight="bold"
                aria-hidden="true"
                className="text-muted-foreground"
              />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
