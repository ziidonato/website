---
import { ArrowRight } from "@phosphor-icons/react"
import { getCollection } from "astro:content"
import ProjectCard from "@/components/ProjectCard.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import { buttonVariants } from "@/components/ui/button"

const isProd = import.meta.env.PROD
const all = await getCollection("projects", ({ data }) =>
  isProd ? data.draft !== true : true
)

const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)

const totalPublished = all.length
const hiddenCount = totalPublished - featured.length
---

<section id="projects" class="mx-auto max-w-4xl scroll-mt-20 px-6 py-16">
  <div class="mb-10 flex items-end justify-between gap-4">
    <SectionHeading eyebrow="03 / Projects" accent="#caffbf" class="mb-0">
      Selected projects
    </SectionHeading>
    <span class="text-sm text-muted-foreground">
      {featured.length} of {totalPublished}
    </span>
  </div>

  {
    featured.length === 0 ? (
      <p class="text-muted-foreground">
        No featured projects yet. Set{" "}
        <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">
          featured: true
        </code>{" "}
        on a project's frontmatter.
      </p>
    ) : (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {featured.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    )
  }

  {
    hiddenCount > 0 && (
      <div class="mt-8 flex justify-center">
        <a
          href="/projects"
          class={buttonVariants({ variant: "outline", size: "lg" }) + " gap-2"}
        >
          View all {totalPublished} projects
          <ArrowRight size={16} weight="bold" aria-hidden="true" />
        </a>
      </div>
    )
  }
</section>
