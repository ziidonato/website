---
import { ArrowRightIcon } from "@phosphor-icons/react"
import { getCollection } from "astro:content"
import ProjectCard from "@/components/ProjectCard.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import { splitProjects } from "@/lib/projects"
import { RAINBOW, rainbowAt } from "@/lib/rainbow"

const isProd = import.meta.env.PROD
const all = await getCollection("projects", ({ data }) =>
  isProd ? data.draft !== true : true
)

const { featured } = splitProjects(all)

const totalPublished = all.length
const hiddenCount = totalPublished - featured.length
---

<section
  id="projects"
  class="mx-auto max-w-4xl scroll-mt-20 px-6 py-16"
  style={{ "--accent": RAINBOW[2] }}
>
  <SectionHeading accent={RAINBOW[2]}>
    Highlighted projects
    <span slot="aside" class="type-label text-muted-foreground/70 tabular-nums">
      {featured.length} of {totalPublished}
    </span>
  </SectionHeading>

  {
    featured.length === 0 ? (
      <p class="text-foreground">
        No projects yet. Add a file to{" "}
        <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">
          src/content/projects
        </code>
        .
      </p>
    ) : (
      <div class="[&>article]:py-6 [&>article:first-child]:pt-0 [&>article:last-child]:pb-0">
        {featured.map((project, index) => (
          <ProjectCard project={project} accent={rainbowAt(index, 2)} />
        ))}
      </div>
    )
  }

  {
    hiddenCount > 0 && (
      <p class="mt-8 text-sm">
        <a
          href="/projects"
          class="inline-flex items-center gap-1 font-medium text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
        >
          View all {totalPublished} projects
          <ArrowRightIcon size={14} weight="bold" aria-hidden="true" />
        </a>
      </p>
    )
  }
</section>
