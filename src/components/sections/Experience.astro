---
import { getCollection } from "astro:content"
import ExperienceCard from "@/components/ExperienceCard.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import { RAINBOW, rainbowAt } from "@/lib/rainbow"

const isProd = import.meta.env.PROD
const all = await getCollection("experience", ({ data }) =>
  isProd ? data.draft !== true : true
)

const monthIndex = (ym: string) => {
  if (ym === "present") return 9999
  const [y, m] = ym.split("-").map(Number)
  return y * 12 + (m - 1)
}

const entries = all.sort(
  (a, b) => monthIndex(b.data.end) - monthIndex(a.data.end)
)
---

<section
  id="experience"
  class="mx-auto max-w-4xl scroll-mt-20 px-6 py-16"
  style={{ "--accent": RAINBOW[0] }}
>
  <SectionHeading accent={RAINBOW[0]}>
    Experience
    {
      entries.length > 0 && (
        <span
          slot="aside"
          class="type-label text-muted-foreground/70 tabular-nums"
        >
          {entries.length} {entries.length === 1 ? "role" : "roles"}
        </span>
      )
    }
  </SectionHeading>

  {
    entries.length === 0 ? (
      <p class="text-foreground">
        No experience entries yet. Drop a markdown file into{" "}
        <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">
          src/content/experience/
        </code>
        .
      </p>
    ) : (
      <div class="divide-y divide-border/60 [&>article]:py-6 [&>article:first-child]:pt-0 [&>article:last-child]:pb-0">
        {entries.map((entry, index) => (
          <ExperienceCard entry={entry} accent={rainbowAt(index, 0)} />
        ))}
      </div>
    )
  }

  <div class="mt-10 border-t border-border/60 pt-6">
    <h3
      class="type-label mb-3 flex items-baseline gap-2.5 border-b pb-1.5 text-muted-foreground"
    >
      <span
        aria-hidden="true"
        class="inline-block h-3 w-[3px] shrink-0 bg-accent"></span>
      Education
    </h3>
    <p class="text-sm">
      <span class="type-title text-base">University of Connecticut</span>
      <span class="text-muted-foreground">
        — B.S. Computer Science, Math minor</span
      >
    </p>
  </div>
</section>
