---
import { getCollection } from "astro:content"
import ExperienceCard from "@/components/ExperienceCard.astro"
import SectionHeading from "@/components/SectionHeading.astro"

const isProd = import.meta.env.PROD
const all = await getCollection("experience", ({ data }) =>
  isProd ? data.draft !== true : true
)

const monthIndex = (ym: string) => {
  if (ym === "present") return 9999
  const [y, m] = ym.split("-").map(Number)
  return y * 12 + (m - 1)
}

const entries = all.sort(
  (a, b) => monthIndex(b.data.end) - monthIndex(a.data.end)
)
---

<section id="experience" class="mx-auto max-w-4xl scroll-mt-20 px-6 py-16">
  <div class="mb-10 flex items-end justify-between gap-4">
    <SectionHeading eyebrow="01 / Experience" accent="var(--accent-red)" class="mb-0">
      Experience
    </SectionHeading>
    {
      entries.length > 0 && (
        <span class="text-sm text-muted-foreground">
          {entries.length} {entries.length === 1 ? "role" : "roles"}
        </span>
      )
    }
  </div>

  {
    entries.length === 0 ? (
      <p class="text-muted-foreground">
        No experience entries yet. Drop a markdown file into{" "}
        <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">
          src/content/experience/
        </code>
        .
      </p>
    ) : (
      <div class="flex flex-col gap-6">
        {entries.map((entry, index) => (
          <ExperienceCard entry={entry} index={index} />
        ))}
      </div>
    )
  }

  <div class="mt-10 border-t border-border/60 pt-6">
    <h3
      class="mb-3 flex items-center gap-2 font-mono text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase"
    >
      <span
        aria-hidden="true"
        class="inline-block h-1.5 w-1.5 rounded-full bg-accent-blue"></span>
      Education
    </h3>
    <p class="text-sm text-foreground/90">
      <span class="font-medium">University of Connecticut</span>
      <span class="text-muted-foreground">
        — B.S. Computer Science, Math minor</span
      >
    </p>
  </div>
</section>
