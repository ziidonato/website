---
import { ArrowUpRight } from "@phosphor-icons/react"
import type { CollectionEntry } from "astro:content"
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  CardFooter,
} from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"

interface Props {
  project: CollectionEntry<"projects">
  index?: number
}

const { project, index = 0 } = Astro.props
const { title, summary, start, end, tech, links } = project.data
const { Content } = await project.render()
const hasBody = (project.body ?? "").trim().length > 0

const fmt = (ym: string) => {
  const [y, m] = ym.split("-").map(Number)
  return new Date(y, m - 1, 1).toLocaleString("en-US", {
    month: "short",
    year: "numeric",
  })
}

let dateLabel: string
if (end === "ongoing") {
  dateLabel = start ? `Since ${fmt(start)}` : "Ongoing"
} else if (start && start !== end) {
  dateLabel = `${fmt(start)} – ${fmt(end)}`
} else {
  dateLabel = fmt(end)
}

const ACCENTS = [
  "#ffadad",
  "#ffd6a5",
  "#fdffb6",
  "#caffbf",
  "#9bf6ff",
  "#a0c4ff",
  "#bdb2ff",
]
const accent = ACCENTS[index % ACCENTS.length]
---

<Card
  className="relative overflow-hidden transition-shadow hover:shadow-md"
  style={{ "--accent": accent }}
>
  <span
    aria-hidden="true"
    class="absolute inset-y-0 left-0 w-1 bg-[var(--accent)]"></span>

  <CardHeader>
    <div class="flex items-baseline justify-between gap-4">
      <CardTitle class="font-heading text-xl leading-tight font-semibold">
        {title}
      </CardTitle>
      <span
        class="shrink-0 font-mono text-xs tracking-wide uppercase tabular-nums"
        style={`color: color-mix(in oklab, var(--accent) 60%, var(--muted-foreground))`}
      >
        {dateLabel}
      </span>
    </div>

    {
      tech.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {tech.map((t) => (
            <li>
              <Badge
                variant="outline"
                className="font-normal"
                style={{
                  backgroundColor: `color-mix(in oklab, ${accent} 20%, transparent)`,
                  borderColor: `color-mix(in oklab, ${accent} 55%, transparent)`,
                }}
              >
                {t}
              </Badge>
            </li>
          ))}
        </ul>
      )
    }

    <CardDescription class="mt-3 text-base leading-relaxed text-pretty">
      {summary}
    </CardDescription>
  </CardHeader>

  {
    hasBody && (
      <CardContent class="prose-project text-sm leading-relaxed text-foreground/90">
        <Content />
      </CardContent>
    )
  }

  {
    links.length > 0 && (
      <CardFooter class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {links.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="inline-flex items-center gap-1 font-medium text-foreground underline-offset-4 hover:underline focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
                rel="noopener"
                target="_blank"
              >
                {label}
                <ArrowUpRight size={14} weight="bold" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </CardFooter>
    )
  }
</Card>
