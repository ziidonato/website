---
import type { CollectionEntry } from "astro:content"
import { CaretDownIcon, CaretUpIcon } from "@phosphor-icons/react"
import EntryCard from "@/components/EntryCard.astro"

interface Props {
  project: CollectionEntry<"projects">
  /** This record's hue, from the section's walk of the palette. */
  accent: string
  /**
   * The homepage pitches a project and /projects documents it. Only the
   * documentation page shows the stack and the written body; on the homepage
   * they compete with the blurb and, for the stack, repeat the Skills section
   * rendered immediately above it.
   */
  detailed?: boolean
}

const { project, accent, detailed = false } = Astro.props
const { Content } = await project.render()
const hasStory = (project.body ?? "").trim().length > 0
const { title, summary, year, highlight, tech, links, cover, coverAlt } =
  project.data

const slug = project.id.replace(/\.mdx?$/, "")
/* The header anchor and the disclosure need different targets: a deep link to
 * `#project-x` must land on the title, while `open` must be set on the
 * `<details>` element. */
const storyId = `story-${slug}`
---

<EntryCard
  anchorId={`project-${slug}`}
  title={title}
  meta={year ? String(year) : undefined}
  highlight={highlight}
  summary={summary}
  tech={detailed ? tech : []}
  links={links}
  accent={accent}
  rail={detailed}
>
  {/* One affordance, not two: the summary is the only control, and it sits
       under the body when open. `<summary>` cannot move, so the markup puts
       the body first and the summary last, and `order` flips the pair while
       collapsed — the summary stays a child of `<details>`, which is what
       keeps the native toggle working, while reading as the line above or
       below the text.

       No `name`: a shared name is a native exclusive accordion, so opening one
       story closed every other one, and a reader comparing two projects lost
       the first. Independent disclosures also match the anchor behaviour below
       — a `#story-…` deep link opens its card regardless of what else is open.
       Do not add `name` back to "make it tidier"; the exclusivity is the bug. */}
  {
    detailed && hasStory && (
      <details id={storyId} class="group/details mt-3 flex scroll-mt-20 flex-col">
        <summary class="type-meta order-first flex cursor-pointer list-none items-center gap-1.5 text-muted-foreground transition-colors duration-150 group-open/details:order-last group-open/details:mt-3 hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none [&::-webkit-details-marker]:hidden">
          {
            /* Two icons rather than one rotated: `class` is not forwarded by
               the Phosphor React components (they take `className`), so the
               rotate utility silently did nothing. Visibility toggling is the
               same mechanism the label already uses. */
          }
          <span class="group-open/details:hidden">
            <CaretDownIcon size={11} weight="bold" aria-hidden="true" />
          </span>
          <span class="hidden group-open/details:inline">
            <CaretUpIcon size={11} weight="bold" aria-hidden="true" />
          </span>
          <span class="group-open/details:hidden">Read more</span>
          <span class="hidden group-open/details:inline">Show less</span>
        </summary>
        <div class="prose prose-sm mt-2 max-w-none text-foreground prose-neutral dark:prose-invert prose-p:my-3 prose-p:leading-[1.65]">
          <Content />
        </div>
      </details>
    )
  }
  {
    cover && (
      /* Wrapped so an unshot cover leaves no empty slotted rail behind a
         border; the rail's bounded width is what lets the image skip declared
         dimensions. */
      <Fragment slot="rail">
        <img
          src={cover}
          alt={coverAlt ?? ""}
          width={1280}
          height={720}
          loading="lazy"
          decoding="async"
          class="w-full rounded-md object-cover"
        />
      </Fragment>
    )
  }
</EntryCard>
