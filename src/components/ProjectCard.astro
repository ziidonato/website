---
import type { CollectionEntry } from "astro:content"
import { CaretDownIcon } from "@phosphor-icons/react"
import EntryCard from "@/components/EntryCard.astro"

interface Props {
  project: CollectionEntry<"projects">
  /** This record's hue, from the section's walk of the palette. */
  accent: string
  /**
   * The homepage pitches a project and /projects documents it. Only the
   * documentation page shows the stack and the written body; on the homepage
   * they compete with the blurb and, for the stack, repeat the Skills section
   * rendered immediately above it.
   */
  detailed?: boolean
}

const { project, accent, detailed = false } = Astro.props
const { Content } = await project.render()
const hasStory = (project.body ?? "").trim().length > 0
const { title, summary, year, highlight, tech, links, cover, coverAlt } =
  project.data

const slug = project.id.replace(/\.mdx?$/, "")
/* The header anchor and the disclosure need different targets: a deep link to
 * `#project-x` must land on the title, while `open` must be set on the
 * `<details>` element. */
const storyId = `story-${slug}`
---

<EntryCard
  anchorId={`project-${slug}`}
  title={title}
  meta={year ? String(year) : undefined}
  highlight={highlight}
  summary={summary}
  tech={detailed ? tech : []}
  links={links}
  accent={accent}
  rail={detailed}
>
  {
    detailed && hasStory && (
      <details
        id={storyId}
        name="project-story"
        class="group/details mt-3 scroll-mt-20"
      >
        <summary class="type-meta flex cursor-pointer list-none items-center gap-1.5 text-muted-foreground transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none [&::-webkit-details-marker]:hidden">
          <CaretDownIcon
            size={11}
            weight="bold"
            aria-hidden="true"
            class="transition-transform duration-150 group-open/details:rotate-180"
          />
          <span class="group-open/details:hidden">Read more</span>
        </summary>
        <div class="prose prose-sm mt-2 max-w-none text-foreground prose-neutral dark:prose-invert prose-p:my-3 prose-p:leading-[1.65]">
          <Content />
        </div>
        {
          /* A <summary> is pinned to the top of its <details>, so the closing
             control lives outside it and closes the element from the sibling.
             Only rendered once open, which is also when it is needed. */
        }
        <button
          type="button"
          class="type-meta mt-3 hidden cursor-pointer items-center gap-1.5 text-muted-foreground transition-colors duration-150 group-open/details:flex hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
          onclick="this.closest('details').open = false"
        >
          <CaretDownIcon
            size={11}
            weight="bold"
            aria-hidden="true"
            class="rotate-180"
          />
          Show less
        </button>
      </details>
    )
  }
  {
    cover && (
      /* Wrapped so an unshot cover leaves no empty slotted rail behind a
         border; the rail's bounded width is what lets the image skip declared
         dimensions. */
      <Fragment slot="rail">
        <img
          src={cover}
          alt={coverAlt ?? ""}
          width={1280}
          height={720}
          loading="lazy"
          decoding="async"
          class="w-full rounded-md object-cover"
        />
      </Fragment>
    )
  }
</EntryCard>
