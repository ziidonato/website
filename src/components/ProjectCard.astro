---
import type { CollectionEntry } from "astro:content"
import { CaretDown } from "@phosphor-icons/react"
import EntryCard from "@/components/EntryCard.astro"

interface Props {
  project: CollectionEntry<"projects">
  /** This record's hue, from the section's walk of the palette. */
  accent: string
}

const { project, accent } = Astro.props
const { Content } = await project.render()
const hasStory = (project.body ?? "").trim().length > 0
const {
  title,
  summary,
  start,
  end,
  highlight,
  status,
  tech,
  links,
  cover,
  coverAlt,
} = project.data

const fmt = (ym: string) => {
  if (ym === "ongoing") return "Ongoing"
  const [y, m] = ym.split("-").map(Number)
  return new Date(y, m - 1, 1).toLocaleString("en-US", {
    month: "short",
    year: "numeric",
  })
}
const meta = start ? `${fmt(start)} – ${fmt(end)}` : fmt(end)

const statusLabel =
  status === "wip" ? "In progress" : status === "live" ? "Live" : undefined
---

<EntryCard
  anchorId={`project-${project.id.replace(/\.mdx?$/, "")}`}
  title={title}
  meta={meta}
  status={statusLabel}
  highlight={highlight}
  summary={summary}
  tech={tech}
  links={links}
  accent={accent}
>
  {
    cover && (
      /* Covers are still being shot, so this branch is unexercised; it is kept
         so adding one to a markdown file is the only change needed. Dimensions
         are declared to hold layout before the image loads. */
      <img
        src={cover}
        alt={coverAlt ?? ""}
        width={1280}
        height={720}
        loading="lazy"
        decoding="async"
        class="w-full rounded-md object-cover"
      />
    )
  }
  {
    hasStory && (
      <details class="group/details mt-3">
        <summary class="type-meta flex cursor-pointer list-none items-center gap-1.5 text-muted-foreground transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none [&::-webkit-details-marker]:hidden">
          <CaretDown
            size={11}
            weight="bold"
            aria-hidden="true"
            class="transition-transform duration-150 group-open/details:rotate-180"
          />
          Read more
        </summary>
        <div class="type-body mt-2 text-ink">
          <Content />
        </div>
      </details>
    )
  }
</EntryCard>
