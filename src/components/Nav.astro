---
import { Sun, Moon } from "@phosphor-icons/react"

const links = [
  { href: "/#experience", label: "Experience" },
  { href: "/#skills", label: "Skills" },
  { href: "/#projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
]
---

<header
  class="sticky top-0 z-40 border-b border-border/40 bg-background/70 backdrop-blur"
>
  <div aria-hidden="true" class="rainbow-bar h-[3px] w-full"></div>
  <nav
    class="mx-auto flex h-14 max-w-4xl items-center justify-between px-6"
    aria-label="Primary"
  >
    <a
      href="/#top"
      class="group relative text-base font-semibold tracking-tight transition-colors duration-150 hover:text-foreground/80 sm:text-lg"
      aria-label="Zii Donato (pronounced zai duh-NAH-toh)"
    >
      <span class="border-b-2 border-dashed border-muted-foreground/70 transition-colors duration-150 group-hover:border-foreground">
        Zii Donato
      </span>
      <span
        role="tooltip"
        class="pointer-events-none absolute top-full left-0 z-50 mt-2 whitespace-nowrap rounded-md bg-foreground px-2.5 py-1 font-mono text-xs text-background opacity-0 shadow-md transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100"
      >
        zai duh-NAH-toh
      </span>
    </a>
    <ul class="flex items-center gap-1 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-150 hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle theme"
          class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition-colors duration-150 hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
        >
          <Sun
            size={18}
            weight="regular"
            aria-hidden="true"
            className="hidden dark:block"
          />
          <Moon
            size={18}
            weight="regular"
            aria-hidden="true"
            className="block dark:hidden"
          />
        </button>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  const toggle = document.getElementById("theme-toggle")
  toggle?.addEventListener("click", () => {
    const root = document.documentElement
    const next = root.classList.toggle("dark") ? "dark" : "light"
    localStorage.setItem("theme", next)
  })
</script>

<style>
  .rainbow-bar {
    background: linear-gradient(
      to right,
      var(--accent-red),
      var(--accent-orange),
      var(--accent-yellow),
      var(--accent-green),
      var(--accent-blue),
      var(--accent-purple),
      var(--accent-blue),
      var(--accent-green),
      var(--accent-yellow),
      var(--accent-orange),
      var(--accent-red),
      var(--accent-orange),
      var(--accent-yellow),
      var(--accent-green),
      var(--accent-blue),
      var(--accent-purple),
      var(--accent-blue),
      var(--accent-green),
      var(--accent-yellow),
      var(--accent-orange),
      var(--accent-red)
    );
    background-size: 200% 100%;
    animation: rainbow-flow 12s linear infinite;
  }
  @keyframes rainbow-flow {
    from {
      background-position: 0% 0%;
    }
    to {
      background-position: -100% 0%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rainbow-bar {
      animation: none;
    }
  }
</style>
