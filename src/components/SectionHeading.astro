---
interface Props {
  accent: string
  class?: string
}

const { accent, class: className = "" } = Astro.props
---

{
  /* The optional `aside` slot shares the heading's baseline and its rule, so a
    count or filter reads as part of the heading rather than a label stranded
    in the gap beneath it.

    Weight is the hierarchy here, not size alone: the heading is the heaviest
    thing on the page, tracking is pulled in tight so the word reads as one
    mass, and the accent underline stops at the words so the colour belongs to
    the heading rather than to the page. `--accent` is set here as well as on
    the section root, so a heading keeps its hue even when used outside a
    section that declares one. */
}
<div class:list={["mb-10", className]} style={`--accent: ${accent}`}>
  <div
    class="relative flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 pb-3 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-border/70"
  >
    <h2 class="type-heading relative pb-3 text-balance">
      <slot />
      {
        /* Sits under the words only, with a slight overhang past the last
          glyph so it reads as drawn rather than clipped to the text box. */
      }
      <span
        aria-hidden="true"
        class="absolute inset-x-0 -bottom-px h-[3px] rounded-full bg-accent"
      ></span>
    </h2>
    <slot name="aside" />
  </div>
</div>
